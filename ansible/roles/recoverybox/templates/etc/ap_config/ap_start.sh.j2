#!/bin/bash
## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
WORKDIR=$(dirname "$0")

cat "$WORKDIR"/hostapd_base.conf "$WORKDIR"/hostapd_extra.conf > "$WORKDIR"/hostapd.conf
rfkill unblock wifi

ip link set "{{ recoverybox_interface_lan }}" up

docker rm -f hotspot 2>/dev/null

docker run --rm \
    --net=host \
    --cap-add=NET_ADMIN \
    --cap-add=NET_RAW \
    --privileged \
    -e WLAN_INT="{{ recoverybox_interface_lan }}" \
    -e WLAN_IP="{{ recoverybox_hotspot_conf.ip }}" \
    -e WLAN_MASK="{{ recoverybox_hotspot_conf.mask }}" \
    -v /etc/ap_config/:/etc/conf \
    --name hotspot \
    mrdgidgi/simple-hotspot:"{{ recoverybox_version_simple_hotspot }}"