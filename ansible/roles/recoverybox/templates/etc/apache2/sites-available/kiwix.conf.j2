{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName kiwix.recovery.box
  ServerAlias www.kiwix.recovery.box

  Redirect permanent / https://kiwix.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName kiwix.recovery.box

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    ProxyPass        / http://127.0.0.1:18001/
    ProxyPassReverse / http://127.0.0.1:18001/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/kiwix_error.log
    CustomLog ${APACHE_LOG_DIR}/kiwix_access.log combined
</VirtualHost>