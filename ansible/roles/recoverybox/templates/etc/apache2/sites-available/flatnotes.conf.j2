{ % if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName flatnotes.recovery.box
  ServerAlias www.flatnotes.recovery.box

  Redirect permanent / https://flatnotes.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName flatnotes.recovery.box

{ % if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/private/recoverybox.key
{ % endif %}

    ProxyPass        / http://127.0.0.1:18006/
    ProxyPassReverse / http://127.0.0.1:18006/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/flatnotes_error.log
    CustomLog ${APACHE_LOG_DIR}/flatnotes_access.log combined
</VirtualHost>