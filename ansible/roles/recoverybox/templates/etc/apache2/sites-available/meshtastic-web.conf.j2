## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName meshtastic.recovery.box
  ServerAlias www.meshtastic.recovery.box

  Redirect permanent / https://meshtastic.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName meshtastic.recovery.box

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    ProxyPass        / http://127.0.0.1:18000/
    ProxyPassReverse / http://127.0.0.1:18000/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/meshtastic_error.log
    CustomLog ${APACHE_LOG_DIR}/meshtastic_access.log combined
</VirtualHost>
