## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName map.recovery.box
  ServerAlias www.map.recovery.box

  Redirect permanent / https://map.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName map.recovery.box

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    DocumentRoot /data/brouter/www
    
    <Directory /data/brouter/www>
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    #To BRouter
    ProxyPass /brouter http://127.0.0.1:18004
    ProxyPassReverse /brouter http://127.0.0.1:18004

    ##To TileServer-GL
    ProxyPreserveHost On
    ProxyPass /tiles/ http://127.0.0.1:18003/
    ProxyPassReverse /tiles/ http://127.0.0.1:18003/

    ErrorLog ${APACHE_LOG_DIR}/carto_error.log
    CustomLog ${APACHE_LOG_DIR}/carto_access.log combined
</VirtualHost>
