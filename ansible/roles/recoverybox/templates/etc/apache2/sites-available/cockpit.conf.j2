<VirtualHost *:80> 
  ServerName cockpit.recovery.box
  ServerAlias www.cockpit.recovery.box

  Redirect permanent / https://cockpit.recovery.box/
</VirtualHost>
<VirtualHost *:443>
    ServerName cockpit.recovery.box

    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key

    SSLProxyEngine On
    SSLProxyVerify none
    SSLProxyCheckPeerName off
    SSLProxyCheckPeerCN off

    ProxyPreserveHost On

    ProxyPass / https://127.0.0.1:9090/ upgrade=websocket
    ProxyPassReverse / https://127.0.0.1:9090/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/cockpit_error.log
    CustomLog ${APACHE_LOG_DIR}/cockpit_access.log combined
</VirtualHost>