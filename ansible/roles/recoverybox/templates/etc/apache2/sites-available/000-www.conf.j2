## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName recovery.box
  ServerAlias www.recovery.box

  Redirect permanent / https://recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}

    ServerName recovery.box
    DocumentRoot /data/www
    
{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    <Directory /data/www>
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

<Location />
    Require all granted
</Location>

    ErrorLog ${APACHE_LOG_DIR}/www.error.log
    CustomLog ${APACHE_LOG_DIR}/www.access.log combined
    
</VirtualHost>