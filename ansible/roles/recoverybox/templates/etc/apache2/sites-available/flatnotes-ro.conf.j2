{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName flatnotes-ro.recovery.box
  ServerAlias www.flatnotes-ro.recovery.box

  Redirect permanent / https://flatnotes-ro.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName flatnotes-ro.recovery.box

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    ProxyPass        / http://127.0.0.1:18007/
    ProxyPassReverse / http://127.0.0.1:18007/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/flatnotes-ro_error.log
    CustomLog ${APACHE_LOG_DIR}/flatnotes-ro_access.log combined
</VirtualHost>