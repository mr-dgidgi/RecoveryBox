## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
{ % if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName owrx.recovery.box
  ServerAlias www.owrx.recovery.box

  Redirect permanent / https://owrx.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName owrx.recovery.box

{ % if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/private/recoverybox.key
{ % endif %}

    RewriteEngine On
    # Redirection automatique des requêtes WebSocket (ws://)
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule /(.*) ws://127.0.0.1:18002/$1 [P,L]

    # Proxy HTTP standard
    ProxyPass        / http://127.0.0.1:18002/
    ProxyPassReverse / http://127.0.0.1:18002/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/owrx_error.log
    CustomLog ${APACHE_LOG_DIR}/owrx_access.log combined
</VirtualHost>
