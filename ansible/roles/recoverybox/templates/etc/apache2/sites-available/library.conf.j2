## MANAGED BY ANSIBLE, DO NOT EDIT THIS FILE MANUALLY
{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName library.recovery.box
  ServerAlias www.library.recovery.box

  Redirect permanent / https://library.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName library.recovery.box
    DocumentRoot /data/library

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

<Directory /data/library>
    Options Indexes FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>

<Location />
    Require all granted
</Location>

    ErrorLog ${APACHE_LOG_DIR}/library.error.log
    CustomLog ${APACHE_LOG_DIR}/library.access.log combined
    
</VirtualHost>