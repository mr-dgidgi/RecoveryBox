{% if recoverybox_enable_https %}
<VirtualHost *:80> 
  ServerName filebrowser.recovery.box
  ServerAlias www.filebrowser.recovery.box

  Redirect permanent / https://filebrowser.recovery.box/
</VirtualHost>
<VirtualHost *:443>
{% else %}
<VirtualHost *:80>
{% endif %}
    ServerName filebrowser.recovery.box

{% if recoverybox_enable_https %}
    SSLEngine on
    SSLCertificateFile /etc/ssl/recoverybox/recoverybox.crt
    SSLCertificateKeyFile /etc/ssl/recoverybox/recoverybox.key
{% endif %}

    ProxyPass        / http://127.0.0.1:18005/
    ProxyPassReverse / http://127.0.0.1:18005/

    <Location />
        Require all granted
    </Location>

    ErrorLog ${APACHE_LOG_DIR}/filebrowser_error.log
    CustomLog ${APACHE_LOG_DIR}/filebrowser_access.log combined
</VirtualHost>