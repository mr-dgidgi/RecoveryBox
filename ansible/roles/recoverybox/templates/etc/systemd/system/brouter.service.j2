[Unit]
Description=BRouter Routing Engine
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=10
Restart=always
ExecStartPre=/usr/bin/docker rm -f brouter 2>/dev/null
ExecStart=/usr/bin/docker run --rm --name brouter \
    -v /data/brouter/segments4:/segments4 \
    -v /data/brouter/profiles:/profiles2 \
    -p 18004:17777 \
    joeakeem/brouter:{{ recoverybox_version_brouter_container }}
ExecStop=/usr/bin/docker stop brouter

[Install]
WantedBy=multi-user.target
