[Unit]
Description=RecoveryBox Flatnotes Service
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=10
Restart=always
ExecStartPre=/usr/bin/docker rm -f flatnotes 2>/dev/null
ExecStart=/usr/bin/docker run -d \
  -e "PUID=1000" \
  -e "PGID=1000" \
  {% if recoverybox_flatnotes_open == "open" %}
  -e "FLATNOTES_AUTH_TYPE=none" \
  {% else %}
  -e "FLATNOTES_AUTH_TYPE=password" \
  -e "FLATNOTES_USERNAME={{ recoverybox_flatnotes_secure.username }}" \
  -e "FLATNOTES_PASSWORD={{ recoverybox_flatnotes_secure.password }}" \
  -e "FLATNOTES_SECRET_KEY={{ recoverybox_flatnotes_secure.secret_key }}" \
  {% endif %}
  -v "/data/flatnotes:/data" \
  -p "18006:8080" \
  dullage/flatnotes:{{ recoverybox_version_flatnotes }}

[Install]
WantedBy=multi-user.target