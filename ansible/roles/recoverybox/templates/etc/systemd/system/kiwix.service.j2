[Unit]
Description=Kiwix Offline Server Container
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=3
ExecStartPre=docker rm -f kiwix-server 2>/dev/null
ExecStart=/usr/bin/docker run --rm --name kiwix-server\
  -p 18001:8080\
  -v /data/kiwix:/data\
  ghcr.io/kiwix/kiwix-serve:{{ recoverybox_version_kiwix }}\
  "*.zim"

ExecStop=/usr/bin/docker stop kiwix-server

[Install]
WantedBy=multi-user.target


