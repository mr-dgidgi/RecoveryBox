[Unit]
Description=RecoveryBox Flatnotes Read Only Service
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=10
Restart=always
ExecStartPre=/usr/bin/docker rm -f flatnotes-ro 2>/dev/null
ExecStart=/usr/bin/docker run --rm --name flatnotes-ro \
  -e "PUID=1000" \
  -e "PGID=1000" \
  -e "FLATNOTES_AUTH_TYPE=read_only" \
  -v "/data/flatnotes:/data" \
  -p "18007:8080" \
  dullage/flatnotes:{{ recoverybox_version_flatnotes }}

[Install]
WantedBy=multi-user.target