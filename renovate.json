{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["Pre-Release"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*\\.yml$", "(^|/).*\\.yaml$", "(^|/).*\\.json$", "(^|/).*\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?\\n\\s*\\S+:\\s*\"?(?<currentValue>[^\"]+)\"?"
      ]
    }
  ]
}