{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["Pre-Release"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*\\.sh$"],
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+Vrecoverybox_version_[A-Za-z0-9_]+=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}